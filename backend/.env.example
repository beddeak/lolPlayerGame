DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=lol_manager_app
DB_PASSWORD=replace_with_a_local_password
DB_DATABASE=lol_manager
DB_SSL=false
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN_SECONDS=3600
# Optional Google Sign-In (Web application OAuth client ID; not a client secret).
# Leave blank to keep Google login disabled. See docs/GOOGLE-LOGIN.md.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_ORIGIN=http://localhost:5173
# Optional existing account IDs allowed to POST global catalog data. Empty denies all.
# Obtain your own ID from GET /auth/me; never authorize unknown account IDs.
CATALOG_ADMIN_ACCOUNT_IDS=
DEV_ACCOUNT_EMAIL=developer@example.com
DEV_ACCOUNT_PASSWORD=replace_for_local_seed_only
DEV_ACCOUNT_DISPLAY_NAME=Developer
PORT=3000
